{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseEnabled": false,
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "CMS": {
    "SiteName": "OrkinosaiCMS",
    "DefaultTheme": "Default",
    "EnableModuleDiscovery": false,
    "AllowRegistration": false
  },
  "AzureOpenAI": {
    "Endpoint": "https://your-resource-name.openai.azure.com/",
    "ApiKey": "your-api-key-here",
    "DeploymentName": "gpt-4o",
    "ApiVersion": "2024-08-01-preview",
    "MaxTokens": 800,
    "Temperature": 0.7,
    "TopP": 0.95,
    "FrequencyPenalty": 0,
    "PresencePenalty": 0
  },
  "PythonBackend": {
    "Enabled": true,
    "Port": 8000,
    "Host": "0.0.0.0",
    "Workers": 2,
    "Timeout": 120,
    "LogDirectory": "/home/LogFiles",
    "ConfigPath": "appsettings.json"
  },
  "Zoota": {
    "Name": "Zoota AI Assistant",
    "Version": "2.0.0",
    "WelcomeMessage": "Hi! I'm Zoota 👋 Your friendly AI assistant powered by Azure. I can help you with questions about OrkinosaiCMS!",
    "SystemPrompt": "You are Zoota, a friendly AI assistant for OrkinosaiCMS. OrkinosaiCMS is a modular Content Management System built on .NET 10 and Blazor, inspired by Oqtane CMS and SharePoint. Be helpful, professional, and friendly. Always provide specific, detailed answers. You support both English and Turkish - respond in the language the user is using.",
    "KnowledgeBase": {
      "CompanyName": "OrkinosaiCMS",
      "Website": "https://github.com/orkinosai25-org/orkinosaiCMS",
      "Services": [
        "Modular CMS Architecture",
        "Blazor Server Components",
        ".NET 10 Framework",
        "Entity Framework Core",
        "SharePoint-Inspired Features",
        "Master Pages & Web Parts"
      ],
      "Expertise": [
        ".NET 10 Development",
        "Blazor Development",
        "Content Management Systems",
        "Modular Architecture",
        "Clean Architecture Patterns"
      ]
    }
  }
}
