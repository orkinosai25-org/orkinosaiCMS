@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using OrkinosaiCMS.Web.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthenticationService AuthService
@inject NavigationManager NavigationManager

<div class="cms-navigation-wrapper">
    @if (hasError)
    {
        <div class="nav-error">
            <span>Navigation unavailable</span>
        </div>
    }
    else
    {
        <NavigationRenderer MenuName="@MenuName" SiteId="@SiteId" CssClass="cms-top-nav" />
    }
    
    <div class="nav-actions">
        <AuthorizeView>
            <Authorized>
                <span class="nav-welcome">Welcome, @context.User.Identity?.Name</span>
                <AuthorizeView Roles="Administrator" Context="adminContext">
                    <Authorized>
                        <a class="nav-link nav-admin" href="#" @onclick="HandleAdminClick" @onclick:preventDefault>
                            <span class="admin-icon">⚙️</span> Admin Panel
                        </a>
                    </Authorized>
                </AuthorizeView>
                <a class="nav-link nav-logout" href="#" @onclick="HandleLogout" @onclick:preventDefault>Logout</a>
            </Authorized>
            <NotAuthorized>
                <a class="nav-link nav-login" href="/oqtane-login">
                    <span class="login-icon">🔐</span> Login
                </a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

<style>
    .cms-navigation-wrapper {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .cms-top-nav {
        flex: 1;
    }

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .nav-error {
        padding: 8px 16px;
        background: #fee2e2;
        color: #991b1b;
        border-radius: 6px;
        font-size: 14px;
    }

    .nav-welcome {
        color: #64748b;
        font-size: 14px;
        font-weight: 500;
    }

    .nav-link {
        padding: 8px 16px;
        color: #1e293b;
        text-decoration: none;
        border-radius: 6px;
        transition: all 0.2s;
        font-weight: 500;
        font-size: 14px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .nav-link:hover {
        background: #f1f5f9;
        color: #0078D4;
    }

    .nav-login {
        background: linear-gradient(135deg, #0078D4 0%, #00BCF2 100%);
        color: white;
        font-weight: 600;
        box-shadow: 0 2px 8px rgba(0, 120, 212, 0.3);
    }

    .nav-login:hover {
        background: linear-gradient(135deg, #005a9e 0%, #0096c7 100%);
        color: white;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(0, 120, 212, 0.4);
    }

    .login-icon {
        font-size: 16px;
    }

    .nav-login {
        background: #0078D4;
        color: white;
    }

    .nav-login:hover {
        background: #005a9e;
        color: white;
    }

    .nav-admin {
        background: #0078D4;
        color: white;
        font-weight: 600;
    }

    .nav-admin:hover {
        background: #005a9e;
        color: white;
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(0, 120, 212, 0.3);
    }

    .admin-icon {
        font-size: 16px;
    }

    .nav-logout {
        background: #f1f5f9;
        color: #475569;
    }

    .nav-logout:hover {
        background: #e2e8f0;
        color: #1e293b;
    }
</style>

@code {
    /// <summary>
    /// Name of the navigation menu to render (default: TopNavigation)
    /// </summary>
    [Parameter]
    public string MenuName { get; set; } = "TopNavigation";

    /// <summary>
    /// Site ID for the navigation menu (default: 1)
    /// Can be made configurable for multi-site scenarios
    /// </summary>
    [Parameter]
    public int SiteId { get; set; } = 1;

    private bool hasError = false;

    protected override void OnInitialized()
    {
        try
        {
            // Basic initialization - NavigationRenderer will handle the actual loading
            // Error handling is done at the NavigationRenderer level
            base.OnInitialized();
        }
        catch (Exception)
        {
            hasError = true;
        }
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/cms-home", true);
    }

    private void HandleAdminClick()
    {
        // Navigate to admin panel without force reload - auth state persists
        NavigationManager.NavigateTo("/admin");
    }
}
