@* 
    Legacy Blazor Sample Page - Deprecated
    This is a default Blazor sample page kept for reference.
    It is not included in the CMS navigation.
    To manage navigation, use the Navigation Management system at /admin/navigation
*@
@page "/counter"
@rendermode InteractiveServer

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
