@page "/admin/login"
@inject NavigationManager NavigationManager

<PageTitle>Redirecting to Login - OrkinosaiCMS</PageTitle>

<div class="redirect-container">
    <div class="redirect-message">
        <p>Redirecting to Login...</p>
    </div>
</div>

<style>
    .redirect-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #0078D4, #00BCF2);
    }

    .redirect-message {
        color: white;
        font-size: 20px;
        font-weight: 600;
    }
</style>

@code {
    protected override void OnInitialized()
    {
        // Redirect to login
        NavigationManager.NavigateTo("/oqtane-login", forceLoad: true);
    }
}
