@page "/admin/content"
@rendermode InteractiveServer
@layout OrkinosaiCMS.Web.Components.Layout.Admin.AdminLayout
@using Microsoft.AspNetCore.Authorization
@using OrkinosaiCMS.Core.Entities.Sites
@using OrkinosaiCMS.Core.Interfaces.Services
@inject IContentService ContentService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Content Management - OrkinosaiCMS Admin</PageTitle>

<div class="content-page">
    <div class="page-header">
        <div>
            <h1>Content Management</h1>
            <p>Create and manage your content items and modules</p>
        </div>
        <div class="header-actions">
            <button class="btn-primary" @onclick="ShowCreateContent">
                <span>➕</span> Create Content
            </button>
        </div>
    </div>

    <div class="filter-bar">
        <button class="filter-btn @(selectedFilter == "all" ? "active" : "")" @onclick='() => FilterContent("all")'>
            All Content (@contentItems?.Count() ?? 0)
        </button>
        <button class="filter-btn @(selectedFilter == "published" ? "active" : "")" @onclick='() => FilterContent("published")'>
            📗 Published (@contentItems?.Count(c => c.IsPublished) ?? 0)
        </button>
        <button class="filter-btn @(selectedFilter == "drafts" ? "active" : "")" @onclick='() => FilterContent("drafts")'>
            📝 Drafts (@contentItems?.Count(c => !c.IsPublished) ?? 0)
        </button>
    </div>

    <div class="search-bar">
        <input type="text" 
               class="search-input" 
               placeholder="🔍 Search content by title or body..." 
               @bind="searchTerm" 
               @bind:event="oninput"
               @onkeyup="OnSearchChanged" />
        
        <select class="filter-select" @bind="typeFilter" @bind:after="OnFilterChanged">
            <option value="">All Types</option>
            <option value="HTML">HTML</option>
            <option value="Document">Document</option>
            <option value="Image">Image</option>
            <option value="Video">Video</option>
            <option value="Custom">Custom</option>
        </select>

        <select class="filter-select" @bind="categoryFilter" @bind:after="OnFilterChanged">
            <option value="">All Categories</option>
            @if (categories != null)
            {
                @foreach (var cat in categories)
                {
                    <option value="@cat">@cat</option>
                }
            }
        </select>
    </div>

    @if (contentItems == null)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Loading content...</p>
        </div>
    }
    else if (!filteredContent.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">📝</div>
            <h3>@(string.IsNullOrEmpty(searchTerm) ? "No content yet" : "No content found")</h3>
            <p>@(string.IsNullOrEmpty(searchTerm) ? "Create your first content item to get started" : "Try adjusting your search or filters")</p>
            @if (string.IsNullOrEmpty(searchTerm))
            {
                <button class="btn-primary" @onclick="ShowCreateContent">
                    Create Content
                </button>
            }
        </div>
    }
    else
    {
        <div class="content-grid">
            @foreach (var content in filteredContent.OrderByDescending(c => c.ModifiedOn ?? c.CreatedOn))
            {
                <div class="content-card @(!content.IsPublished ? "draft" : "")">
                    <div class="card-header">
                        <div class="card-type">
                            @GetContentIcon(content.ContentType) @content.ContentType
                        </div>
                        @if (content.IsPublished)
                        {
                            <span class="status-badge published">✓ Published</span>
                        }
                        else
                        {
                            <span class="status-badge draft">📝 Draft</span>
                        }
                    </div>
                    
                    <h3 class="card-title">@content.Title</h3>
                    
                    @if (!string.IsNullOrEmpty(content.Body))
                    {
                        <p class="card-body">@GetExcerpt(content.Body, 120)</p>
                    }
                    
                    <div class="card-meta">
                        @if (!string.IsNullOrEmpty(content.Category))
                        {
                            <span class="meta-tag category">📁 @content.Category</span>
                        }
                        @if (!string.IsNullOrEmpty(content.Tags))
                        {
                            @foreach (var tag in content.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries).Take(3))
                            {
                                <span class="meta-tag">🏷️ @tag.Trim()</span>
                            }
                        }
                    </div>
                    
                    <div class="card-footer">
                        <div class="card-date">
                            Updated: @((content.ModifiedOn ?? content.CreatedOn).ToString("MMM dd, yyyy"))
                        </div>
                        <div class="card-actions">
                            <button class="btn-icon" @onclick="() => EditContent(content)" title="Edit">
                                ✏️
                            </button>
                            @if (content.IsPublished)
                            {
                                <button class="btn-icon" @onclick="() => UnpublishContent(content)" title="Unpublish">
                                    ⏸️
                                </button>
                            }
                            else
                            {
                                <button class="btn-icon" @onclick="() => PublishContent(content)" title="Publish">
                                    🚀
                                </button>
                            }
                            <button class="btn-icon danger" @onclick="() => DeleteContent(content)" title="Delete">
                                🗑️
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (showContentEditor)
    {
        <div class="modal-overlay" @onclick="CloseContentEditor">
            <div class="modal-content large" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h2>@(editingContent?.Id > 0 ? "Edit Content" : "Create Content")</h2>
                    <button class="btn-close" @onclick="CloseContentEditor">✕</button>
                </div>
                <div class="modal-body">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Title *</label>
                            <input type="text" class="form-control" @bind="editingContent!.Title" placeholder="Content title" />
                        </div>
                        <div class="form-group">
                            <label>Content Type *</label>
                            <select class="form-control" @bind="editingContent!.ContentType">
                                <option value="HTML">HTML</option>
                                <option value="Document">Document</option>
                                <option value="Image">Image</option>
                                <option value="Video">Video</option>
                                <option value="Custom">Custom</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Content Body</label>
                        <textarea class="form-control content-editor" @bind="editingContent!.Body" rows="10" placeholder="Enter your content (HTML supported)"></textarea>
                        <small class="form-hint">You can use HTML tags for rich formatting</small>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Category</label>
                            <input type="text" class="form-control" @bind="editingContent!.Category" placeholder="e.g., Blog, News, Documentation" />
                        </div>
                        <div class="form-group">
                            <label>Tags</label>
                            <input type="text" class="form-control" @bind="editingContent!.Tags" placeholder="tag1, tag2, tag3" />
                            <small class="form-hint">Separate tags with commas</small>
                        </div>
                    </div>

                    <div class="form-group checkbox-group">
                        <label>
                            <input type="checkbox" @bind="editingContent!.IsPublished" />
                            <span>Publish immediately</span>
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn-secondary" @onclick="CloseContentEditor">Cancel</button>
                    <button class="btn-primary" @onclick="SaveContent">
                        @(editingContent?.Id > 0 ? "Update Content" : "Create Content")
                    </button>
                </div>
            </div>
        </div>
    }
</div>

