@page "/admin/content"
@rendermode InteractiveServer
@layout OrkinosaiCMS.Web.Components.Layout.Admin.AdminLayout
@using Microsoft.AspNetCore.Authorization

<PageTitle>Content - OrkinosaiCMS Admin</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <h1>Content Management</h1>
        <p>Manage your content items and modules</p>
    </div>

    <div class="coming-soon-card">
        <div class="coming-soon-icon">📝</div>
        <h2>Content Management Coming Soon</h2>
        <p>This feature is currently under development. You will be able to:</p>
        <ul class="feature-list">
            <li>✨ Create and edit content items</li>
            <li>📋 Manage HTML content and rich text</li>
            <li>🔧 Configure content modules</li>
            <li>🎨 Add web parts to pages</li>
            <li>📊 Organize content categories</li>
        </ul>
        <p class="note">In the meantime, you can manage navigation and themes from the sidebar.</p>
    </div>
</div>

<style>
    .admin-page {
        padding: 30px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 40px;
    }

    .page-header h1 {
        color: #0078D4;
        font-size: 32px;
        margin-bottom: 8px;
    }

    .page-header p {
        color: #666;
        font-size: 16px;
    }

    .coming-soon-card {
        background: white;
        border-radius: 12px;
        padding: 48px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        text-align: center;
    }

    .coming-soon-icon {
        font-size: 72px;
        margin-bottom: 24px;
    }

    .coming-soon-card h2 {
        color: #333;
        font-size: 28px;
        margin-bottom: 16px;
    }

    .coming-soon-card > p {
        color: #666;
        font-size: 16px;
        margin-bottom: 24px;
    }

    .feature-list {
        list-style: none;
        padding: 0;
        margin: 24px 0;
        text-align: left;
        max-width: 500px;
        margin-left: auto;
        margin-right: auto;
    }

    .feature-list li {
        padding: 12px 16px;
        color: #333;
        font-size: 15px;
        border-left: 3px solid #0078D4;
        margin-bottom: 8px;
        background: #f8f9fa;
        border-radius: 4px;
    }

    .note {
        margin-top: 32px;
        padding: 16px;
        background: #e7f3ff;
        border-left: 4px solid #0078D4;
        border-radius: 4px;
        color: #004578;
        font-size: 14px;
    }
</style>
