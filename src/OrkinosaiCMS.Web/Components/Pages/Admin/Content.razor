@code {
    private List<OrkinosaiCMS.Core.Entities.Sites.Content>? contentItems;
    private List<OrkinosaiCMS.Core.Entities.Sites.Content> filteredContent = new();
    private List<string>? categories;
    private string selectedFilter = "all";
    private string searchTerm = string.Empty;
    private string typeFilter = string.Empty;
    private string categoryFilter = string.Empty;
    private bool showContentEditor = false;
    private OrkinosaiCMS.Core.Entities.Sites.Content? editingContent;
    private const int DefaultSiteId = 1;
    private System.Threading.Timer? searchDebounceTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadContent();
    }

    private async Task LoadContent()
    {
        try
        {
            var allContent = await ContentService.GetBySiteAsync(DefaultSiteId);
            contentItems = allContent.ToList();
            
            // Extract unique categories
            categories = contentItems
                .Where(c => !string.IsNullOrEmpty(c.Category))
                .Select(c => c.Category!)
                .Distinct()
                .OrderBy(c => c)
                .ToList();
            
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading content: {ex.Message}");
        }
    }

    private void FilterContent(string filter)
    {
        selectedFilter = filter;
        ApplyFilters();
    }

    private void OnSearchChanged()
    {
        searchDebounceTimer?.Dispose();
        searchDebounceTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                ApplyFilters();
                StateHasChanged();
            });
        }, null, 300, Timeout.Infinite);
    }

    private void OnFilterChanged()
    {
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        if (contentItems == null)
        {
            filteredContent = new();
            return;
        }

        var filtered = contentItems.AsEnumerable();

        // Apply status filter
        filtered = selectedFilter switch
        {
            "published" => filtered.Where(c => c.IsPublished),
            "drafts" => filtered.Where(c => !c.IsPublished),
            _ => filtered
        };

        // Apply type filter
        if (!string.IsNullOrEmpty(typeFilter))
        {
            filtered = filtered.Where(c => c.ContentType == typeFilter);
        }

        // Apply category filter
        if (!string.IsNullOrEmpty(categoryFilter))
        {
            filtered = filtered.Where(c => c.Category == categoryFilter);
        }

        // Apply search
        if (!string.IsNullOrEmpty(searchTerm))
        {
            var search = searchTerm.ToLower();
            filtered = filtered.Where(c =>
                (!string.IsNullOrEmpty(c.Title) && c.Title.Contains(search, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(c.Body) && c.Body.Contains(search, StringComparison.OrdinalIgnoreCase))
            );
        }

        filteredContent = filtered.ToList();
    }

    private void ShowCreateContent()
    {
        editingContent = new OrkinosaiCMS.Core.Entities.Sites.Content
        {
            SiteId = DefaultSiteId,
            ContentType = "HTML",
            IsPublished = false,
            CreatedOn = DateTime.UtcNow
        };
        showContentEditor = true;
    }

    private void EditContent(OrkinosaiCMS.Core.Entities.Sites.Content content)
    {
        editingContent = new OrkinosaiCMS.Core.Entities.Sites.Content
        {
            Id = content.Id,
            SiteId = content.SiteId,
            Title = content.Title,
            ContentType = content.ContentType,
            Body = content.Body,
            Category = content.Category,
            Tags = content.Tags,
            IsPublished = content.IsPublished,
            AuthorId = content.AuthorId
        };
        showContentEditor = true;
    }

    private async Task SaveContent()
    {
        if (editingContent == null || string.IsNullOrWhiteSpace(editingContent.Title))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Please enter a title for the content.");
            return;
        }

        try
        {
            if (editingContent.Id > 0)
            {
                // Update existing content
                var existingContent = await ContentService.GetByIdAsync(editingContent.Id);
                if (existingContent != null)
                {
                    existingContent.Title = editingContent.Title;
                    existingContent.ContentType = editingContent.ContentType;
                    existingContent.Body = editingContent.Body;
                    existingContent.Category = editingContent.Category;
                    existingContent.Tags = editingContent.Tags;
                    existingContent.IsPublished = editingContent.IsPublished;
                    
                    await ContentService.UpdateAsync(existingContent);
                }
            }
            else
            {
                // Create new content
                if (editingContent.IsPublished)
                {
                    editingContent.PublishedOn = DateTime.UtcNow;
                }
                await ContentService.CreateAsync(editingContent);
            }

            CloseContentEditor();
            await LoadContent();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error saving content: {ex.Message}");
        }
    }

    private void CloseContentEditor()
    {
        showContentEditor = false;
        editingContent = null;
    }

    private async Task PublishContent(OrkinosaiCMS.Core.Entities.Sites.Content content)
    {
        try
        {
            await ContentService.PublishAsync(content.Id);
            await LoadContent();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error publishing content: {ex.Message}");
        }
    }

    private async Task UnpublishContent(OrkinosaiCMS.Core.Entities.Sites.Content content)
    {
        try
        {
            await ContentService.UnpublishAsync(content.Id);
            await LoadContent();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error unpublishing content: {ex.Message}");
        }
    }

    private async Task DeleteContent(OrkinosaiCMS.Core.Entities.Sites.Content content)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"Are you sure you want to delete '{content.Title}'? This action cannot be undone.");
        
        if (!confirmed) return;

        try
        {
            await ContentService.DeleteAsync(content.Id);
            await LoadContent();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error deleting content: {ex.Message}");
        }
    }

    private string GetContentIcon(string contentType) => contentType switch
    {
        "HTML" => "📝",
        "Document" => "📄",
        "Image" => "🖼️",
        "Video" => "🎬",
        "Custom" => "🔧",
        _ => "📦"
    };

    private string GetExcerpt(string text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return string.Empty;
        
        // Remove HTML tags for excerpt
        var plainText = System.Text.RegularExpressions.Regex.Replace(text, "<.*?>", string.Empty);
        
        if (plainText.Length <= maxLength) return plainText;
        
        return plainText.Substring(0, maxLength) + "...";
    }

    public void Dispose()
    {
        searchDebounceTimer?.Dispose();
    }
}

