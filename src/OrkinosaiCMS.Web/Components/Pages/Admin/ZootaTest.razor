@code {
    private string uploadedFileName = string.Empty;
    private string testJson = string.Empty;
    private bool isRunning = false;
    private List<TestResult> testResults = new();
    private List<TestFileInfo> availableTestFiles = new();
    private HashSet<string> selectedTestFiles = new();
    private bool selectAllChecked = false;
    
    // Single test entry fields with defaults
    private string singleTestAction = "createPage";
    private string singleTestParamName = "DemoTestPage";
    private bool singleTestExpectCreated = true;

    protected override async Task OnInitializedAsync()
    {
        // If ZootaTesting is disabled, log and potentially redirect
        if (!ZootaTestingOptions.Value.Enabled)
        {
            Logger.LogWarning("Attempted to access Zoota Test Runner while it is disabled in configuration.");
            return;
        }

        // Load available test files from the tests folder
        await LoadAvailableTestFiles();
    }

    private async Task LoadAvailableTestFiles()
    {
        try
        {
            var testsFolder = Path.Combine(Directory.GetCurrentDirectory(), "..", "..", "..", "tests", "zoota-tests");
            
            // If the folder doesn't exist, try alternative path
            if (!Directory.Exists(testsFolder))
            {
                testsFolder = Path.Combine(Directory.GetCurrentDirectory(), "tests", "zoota-tests");
            }

            // Create folder if it doesn't exist
            if (!Directory.Exists(testsFolder))
            {
                Directory.CreateDirectory(testsFolder);
                Logger.LogInformation("Created tests folder at: {Path}", testsFolder);
                return;
            }

            var jsonFiles = Directory.GetFiles(testsFolder, "*.json", SearchOption.TopDirectoryOnly);
            
            availableTestFiles.Clear();
            foreach (var filePath in jsonFiles)
            {
                var fileName = Path.GetFileName(filePath);
                var description = await GetTestDescription(filePath);
                
                availableTestFiles.Add(new TestFileInfo
                {
                    Name = fileName,
                    Path = filePath,
                    Description = description
                });
            }

            Logger.LogInformation("Loaded {Count} test files from {Path}", availableTestFiles.Count, testsFolder);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading available test files");
        }
    }

    private async Task<string> GetTestDescription(string filePath)
    {
        try
        {
            var json = await File.ReadAllTextAsync(filePath);
            var testSuite = System.Text.Json.JsonSerializer.Deserialize<TestSuite>(json);
            return testSuite?.Name ?? string.Empty;
        }
        catch
        {
            return string.Empty;
        }
    }

    private void ToggleSelectAll()
    {
        selectAllChecked = !selectAllChecked;
        
        if (selectAllChecked)
        {
            selectedTestFiles = availableTestFiles.Select(f => f.Path).ToHashSet();
        }
        else
        {
            selectedTestFiles.Clear();
        }
    }

    private void ToggleFileSelection(string filePath)
    {
        if (selectedTestFiles.Contains(filePath))
        {
            selectedTestFiles.Remove(filePath);
        }
        else
        {
            selectedTestFiles.Add(filePath);
        }

        // Update select all checkbox state
        selectAllChecked = selectedTestFiles.Count == availableTestFiles.Count;
    }

    private void ClearSelection()
    {
        selectedTestFiles.Clear();
        selectAllChecked = false;
    }

    private void ResetSingleTest()
    {
        singleTestAction = "createPage";
        singleTestParamName = "DemoTestPage";
        singleTestExpectCreated = true;
    }

    private async Task RunSingleTest()
    {
        isRunning = true;
        testResults.Clear();
        StateHasChanged();

        try
        {
            Logger.LogInformation("Running single test: {Action}", singleTestAction);

            // Create a test step from the form values
            var testStep = new TestStep
            {
                Action = singleTestAction,
                Params = System.Text.Json.JsonSerializer.SerializeToElement(new { name = singleTestParamName }),
                Expect = System.Text.Json.JsonSerializer.SerializeToElement(new { created = singleTestExpectCreated })
            };

            var result = await ExecuteTestStep(testStep);
            testResults.Add(result);

            Logger.LogInformation("Single test execution completed. Passed: {Passed}", result.Passed);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error running single test");
            testResults.Add(new TestResult
            {
                Action = singleTestAction,
                Passed = false,
                Message = "Failed to execute single test",
                Details = ex.Message
            });
        }
        finally
        {
            isRunning = false;
            StateHasChanged();
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                uploadedFileName = file.Name;
                
                using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024); // 1MB limit
                using var reader = new StreamReader(stream);
                testJson = await reader.ReadToEndAsync();
                
                Logger.LogInformation("Custom test file uploaded: {FileName}", uploadedFileName);
                
                // Clear file selection and run the uploaded file
                selectedTestFiles.Clear();
                selectAllChecked = false;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading custom test file");
            testJson = string.Empty;
            uploadedFileName = string.Empty;
        }
    }

    private async Task RunSelectedTests()
    {
        if (!selectedTestFiles.Any())
            return;

        isRunning = true;
        testResults.Clear();
        StateHasChanged();

        try
        {
            Logger.LogInformation("Running {Count} selected test files", selectedTestFiles.Count);

            foreach (var filePath in selectedTestFiles)
            {
                var fileName = Path.GetFileName(filePath);
                Logger.LogInformation("Executing test file: {FileName}", fileName);

                try
                {
                    var json = await File.ReadAllTextAsync(filePath);
                    await ExecuteTestFile(json, fileName);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Error executing test file: {FileName}", fileName);
                    testResults.Add(new TestResult
                    {
                        Action = $"Execute {fileName}",
                        Passed = false,
                        Message = $"Failed to execute test file: {fileName}",
                        Details = ex.Message
                    });
                }

                StateHasChanged();
                await Task.Delay(500); // Small delay between files
            }

            Logger.LogInformation("Test execution completed. Passed: {Passed}, Failed: {Failed}", 
                testResults.Count(r => r.Passed), testResults.Count(r => !r.Passed));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error running selected tests");
            testResults.Add(new TestResult
            {
                Action = "Run Tests",
                Passed = false,
                Message = "Failed to execute tests",
                Details = ex.Message
            });
        }
        finally
        {
            isRunning = false;
            StateHasChanged();
        }
    }

    private async Task ExecuteTestFile(string json, string fileName)
    {
        var testSuite = System.Text.Json.JsonSerializer.Deserialize<TestSuite>(json);
        
        if (testSuite?.Steps == null || !testSuite.Steps.Any())
        {
            testResults.Add(new TestResult
            {
                Action = $"Parse {fileName}",
                Passed = false,
                Message = "No test steps found in file",
                Details = $"File: {fileName}"
            });
            return;
        }

        Logger.LogInformation("Executing {Count} test steps from: {Suite}", 
            testSuite.Steps.Count, testSuite.Name ?? fileName);

        foreach (var step in testSuite.Steps)
        {
            var result = await ExecuteTestStep(step);
            result.Details = $"From: {fileName}\n{result.Details}";
            testResults.Add(result);
            StateHasChanged();
            await Task.Delay(300); // Small delay for better UX
        }
    }

    private async Task RunTests()
    {
        if (string.IsNullOrEmpty(testJson))
            return;

        isRunning = true;
        testResults.Clear();
        StateHasChanged();

        try
        {
            Logger.LogInformation("Starting test execution");
            
            // Parse test JSON
            var testSuite = System.Text.Json.JsonSerializer.Deserialize<TestSuite>(testJson);
            
            if (testSuite?.Steps == null || !testSuite.Steps.Any())
            {
                testResults.Add(new TestResult
                {
                    Action = "Parse Test File",
                    Passed = false,
                    Message = "No test steps found in JSON file",
                    Details = "Ensure your test file has a 'steps' array with test actions"
                });
                return;
            }

            Logger.LogInformation("Executing {Count} test steps from suite: {Suite}", 
                testSuite.Steps.Count, testSuite.Name ?? "Unnamed");

            // Execute each test step
            foreach (var step in testSuite.Steps)
            {
                var result = await ExecuteTestStep(step);
                testResults.Add(result);
                StateHasChanged();
                await Task.Delay(500); // Small delay for better UX
            }

            Logger.LogInformation("Test execution completed. Passed: {Passed}, Failed: {Failed}", 
                testResults.Count(r => r.Passed), testResults.Count(r => !r.Passed));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error running tests");
            testResults.Add(new TestResult
            {
                Action = "Run Tests",
                Passed = false,
                Message = "Failed to execute tests",
                Details = ex.Message
            });
        }
        finally
        {
            isRunning = false;
            StateHasChanged();
        }
    }

    private async Task<TestResult> ExecuteTestStep(TestStep step)
    {
        try
        {
            Logger.LogInformation("Executing test step: {Action}", step.Action);

            // Simulate test execution based on action type
            switch (step.Action?.ToLower())
            {
                case "createpage":
                    return await ExecuteCreatePage(step);
                
                case "addcontent":
                    return await ExecuteAddContent(step);
                
                case "uploadimage":
                    return await ExecuteUploadImage(step);
                
                case "verifycontent":
                    return await ExecuteVerifyContent(step);
                
                default:
                    return new TestResult
                    {
                        Action = step.Action ?? "Unknown",
                        Passed = false,
                        Message = $"Unknown action: {step.Action}",
                        Details = "Supported actions: createPage, addContent, uploadImage, verifyContent"
                    };
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error executing test step: {Action}", step.Action);
            return new TestResult
            {
                Action = step.Action ?? "Unknown",
                Passed = false,
                Message = "Test step execution failed",
                Details = ex.Message
            };
        }
    }

    private async Task<TestResult> ExecuteCreatePage(TestStep step)
    {
        try
        {
            var pageName = step.Params?.GetProperty("name").GetString() ?? "Untitled";
            
            // Call API to create page
            var response = await Http.PostAsJsonAsync("/api/zoota/cms/pages", new
            {
                Title = pageName,
                IsPublished = false
            });

            if (response.IsSuccessStatusCode)
            {
                return new TestResult
                {
                    Action = "createPage",
                    Passed = true,
                    Message = $"Successfully created page: {pageName}",
                    Details = "Page created and available in CMS"
                };
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                return new TestResult
                {
                    Action = "createPage",
                    Passed = false,
                    Message = $"Failed to create page: {pageName}",
                    Details = $"API Error: {response.StatusCode} - {error}"
                };
            }
        }
        catch (Exception ex)
        {
            return new TestResult
            {
                Action = "createPage",
                Passed = false,
                Message = "Error creating page",
                Details = ex.Message
            };
        }
    }

