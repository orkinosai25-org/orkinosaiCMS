@code {
    private string selectedFileName = string.Empty;
    private string testJson = string.Empty;
    private bool isRunning = false;
    private List<TestResult> testResults = new();

    protected override void OnInitialized()
    {
        // If ZootaTesting is disabled, log and potentially redirect
        if (!ZootaTestingOptions.Value.Enabled)
        {
            Logger.LogWarning("Attempted to access Zoota Test Runner while it is disabled in configuration.");
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                selectedFileName = file.Name;
                
                using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024); // 1MB limit
                using var reader = new StreamReader(stream);
                testJson = await reader.ReadToEndAsync();
                
                Logger.LogInformation("Test file loaded: {FileName}", selectedFileName);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading test file");
            testJson = string.Empty;
            selectedFileName = string.Empty;
        }
    }

    private async Task RunTests()
    {
        if (string.IsNullOrEmpty(testJson))
            return;

        isRunning = true;
        testResults.Clear();
        StateHasChanged();

        try
        {
            Logger.LogInformation("Starting test execution");
            
            // Parse test JSON
            var testSuite = System.Text.Json.JsonSerializer.Deserialize<TestSuite>(testJson);
            
            if (testSuite?.Steps == null || !testSuite.Steps.Any())
            {
                testResults.Add(new TestResult
                {
                    Action = "Parse Test File",
                    Passed = false,
                    Message = "No test steps found in JSON file",
                    Details = "Ensure your test file has a 'steps' array with test actions"
                });
                return;
            }

            Logger.LogInformation("Executing {Count} test steps from suite: {Suite}", 
                testSuite.Steps.Count, testSuite.Name ?? "Unnamed");

            // Execute each test step
            foreach (var step in testSuite.Steps)
            {
                var result = await ExecuteTestStep(step);
                testResults.Add(result);
                StateHasChanged();
                await Task.Delay(500); // Small delay for better UX
            }

            Logger.LogInformation("Test execution completed. Passed: {Passed}, Failed: {Failed}", 
                testResults.Count(r => r.Passed), testResults.Count(r => !r.Passed));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error running tests");
            testResults.Add(new TestResult
            {
                Action = "Run Tests",
                Passed = false,
                Message = "Failed to execute tests",
                Details = ex.Message
            });
        }
        finally
        {
            isRunning = false;
            StateHasChanged();
        }
    }

    private async Task<TestResult> ExecuteTestStep(TestStep step)
    {
        try
        {
            Logger.LogInformation("Executing test step: {Action}", step.Action);

            // Simulate test execution based on action type
            switch (step.Action?.ToLower())
            {
                case "createpage":
                    return await ExecuteCreatePage(step);
                
                case "addcontent":
                    return await ExecuteAddContent(step);
                
                case "uploadimage":
                    return await ExecuteUploadImage(step);
                
                case "verifycontent":
                    return await ExecuteVerifyContent(step);
                
                default:
                    return new TestResult
                    {
                        Action = step.Action ?? "Unknown",
                        Passed = false,
                        Message = $"Unknown action: {step.Action}",
                        Details = "Supported actions: createPage, addContent, uploadImage, verifyContent"
                    };
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error executing test step: {Action}", step.Action);
            return new TestResult
            {
                Action = step.Action ?? "Unknown",
                Passed = false,
                Message = "Test step execution failed",
                Details = ex.Message
            };
        }
    }

    private async Task<TestResult> ExecuteCreatePage(TestStep step)
    {
        try
        {
            var pageName = step.Params?.GetProperty("name").GetString() ?? "Untitled";
            
            // Call API to create page
            var response = await Http.PostAsJsonAsync("/api/zoota/cms/pages", new
            {
                Title = pageName,
                IsPublished = false
            });

            if (response.IsSuccessStatusCode)
            {
                return new TestResult
                {
                    Action = "createPage",
                    Passed = true,
                    Message = $"Successfully created page: {pageName}",
                    Details = "Page created and available in CMS"
                };
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                return new TestResult
                {
                    Action = "createPage",
                    Passed = false,
                    Message = $"Failed to create page: {pageName}",
                    Details = $"API Error: {response.StatusCode} - {error}"
                };
            }
        }
        catch (Exception ex)
        {
            return new TestResult
            {
                Action = "createPage",
                Passed = false,
                Message = "Error creating page",
                Details = ex.Message
            };
        }
    }

    private Task<TestResult> ExecuteAddContent(TestStep step)
    {
        // Placeholder implementation
        var pageName = step.Params?.GetProperty("pageName").GetString() ?? "Unknown";
        return Task.FromResult(new TestResult
        {
            Action = "addContent",
            Passed = true,
            Message = $"Content added to page: {pageName}",
            Details = "This is a placeholder implementation. Full implementation pending."
        });
    }

    private Task<TestResult> ExecuteUploadImage(TestStep step)
    {
        // Placeholder implementation
        var pageName = step.Params?.GetProperty("pageName").GetString() ?? "Unknown";
        return Task.FromResult(new TestResult
        {
            Action = "uploadImage",
            Passed = true,
            Message = $"Image uploaded to page: {pageName}",
            Details = "This is a placeholder implementation. Full implementation pending."
        });
    }

    private Task<TestResult> ExecuteVerifyContent(TestStep step)
    {
        // Placeholder implementation
        var pageName = step.Params?.GetProperty("pageName").GetString() ?? "Unknown";
        return Task.FromResult(new TestResult
        {
            Action = "verifyContent",
            Passed = true,
            Message = $"Content verified for page: {pageName}",
            Details = "This is a placeholder implementation. Full implementation pending."
        });
    }

    // Data models for test execution
    private class TestSuite
    {
        public string? Name { get; set; }
        public List<TestStep>? Steps { get; set; }
    }

    private class TestStep
    {
        public string? Action { get; set; }
        public System.Text.Json.JsonElement? Params { get; set; }
        public System.Text.Json.JsonElement? Expect { get; set; }
    }

    private class TestResult
    {
        public string Action { get; set; } = string.Empty;
        public bool Passed { get; set; }
        public string Message { get; set; } = string.Empty;
        public string? Details { get; set; }
    }
}
