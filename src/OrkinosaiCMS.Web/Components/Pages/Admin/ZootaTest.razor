@page "/admin/zoota-test"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Options
@using OrkinosaiCMS.Web.Models
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@layout OrkinosaiCMS.Web.Components.Layout.Admin.AdminLayout
@inject IOptions<ZootaTestingOptions> ZootaTestingOptions
@inject NavigationManager Navigation
@inject ILogger<ZootaTest> Logger
@inject HttpClient Http

<PageTitle>Zoota Test Runner - OrkinosaiCMS</PageTitle>

@if (!ZootaTestingOptions.Value.Enabled)
{
    <div class="test-disabled">
        <div class="disabled-message">
            <h2>⚠️ Test Runner Disabled</h2>
            <p>The Zoota Test Runner is currently disabled in configuration.</p>
            <p>To enable it, set <code>ZootaTesting:Enabled</code> to <code>true</code> in <code>appsettings.json</code>.</p>
            <button class="btn-back" @onclick='() => Navigation.NavigateTo("/admin")'>
                ← Back to Dashboard
            </button>
        </div>
    </div>
}
else
{
    <div class="test-runner">
        <div class="test-header">
            <h1>🧪 Zoota Test Runner</h1>
            <p>JSON-driven automated test suite for CMS feature validation</p>
        </div>

        <div class="test-content">
            <div class="single-test-section">
                <h3>Create Single Test Entry</h3>
                <p>Quickly create and run a single test with customizable parameters</p>
                
                <div class="single-test-form">
                    <div class="form-group">
                        <label for="testAction">Action:</label>
                        <input type="text" id="testAction" @bind="singleTestAction" class="form-input" />
                    </div>
                    
                    <div class="form-group">
                        <label for="testParamName">Page Name:</label>
                        <input type="text" id="testParamName" @bind="singleTestParamName" class="form-input" />
                    </div>
                    
                    <div class="form-group">
                        <label for="testExpectCreated">Expect Created:</label>
                        <input type="checkbox" id="testExpectCreated" @bind="singleTestExpectCreated" class="form-checkbox" />
                    </div>
                    
                    <div class="form-actions">
                        <button class="btn-run-single" @onclick="RunSingleTest" disabled="@isRunning">
                            @if (isRunning)
                            {
                                <span>⏳ Running...</span>
                            }
                            else
                            {
                                <span>▶️ Run Single Test</span>
                            }
                        </button>
                        
                        <button class="btn-reset" @onclick="ResetSingleTest">
                            Reset to Defaults
                        </button>
                    </div>
                </div>
            </div>

            <div class="upload-section">
                <h3>Select Test Files</h3>
                <p>Choose one or more test files from the <code>tests/zoota-tests</code> folder</p>
                
                @if (availableTestFiles.Any())
                {
                    <div class="file-selection">
                        <div class="select-all-container">
                            <label>
                                <input type="checkbox" @bind="selectAllChecked" @onclick="ToggleSelectAll" />
                                <strong>Select All</strong>
                            </label>
                        </div>
                        
                        <div class="file-list">
                            @foreach (var testFile in availableTestFiles)
                            {
                                <div class="file-item">
                                    <label>
                                        <input type="checkbox" 
                                               checked="@selectedTestFiles.Contains(testFile.Path)" 
                                               @onchange="@(() => ToggleFileSelection(testFile.Path))" />
                                        <span class="file-icon">📄</span>
                                        <span class="file-name">@testFile.Name</span>
                                        @if (!string.IsNullOrEmpty(testFile.Description))
                                        {
                                            <span class="file-description">- @testFile.Description</span>
                                        }
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="no-files-message">
                        <p>⚠️ No test files found in <code>tests/zoota-tests</code> folder.</p>
                        <p>Add <code>.json</code> files to the folder to run tests.</p>
                    </div>
                }

                <div class="action-buttons">
                    <button class="btn-run" @onclick="RunSelectedTests" disabled="@(!selectedTestFiles.Any() || isRunning)">
                        @if (isRunning)
                        {
                            <span>⏳ Running Tests...</span>
                        }
                        else
                        {
                            <span>▶️ Run Selected Tests (@selectedTestFiles.Count)</span>
                        }
                    </button>
                    
                    @if (selectedTestFiles.Any())
                    {
                        <button class="btn-clear" @onclick="ClearSelection">
                            Clear Selection
                        </button>
                    }
                </div>
                
                <div class="upload-alternative">
                    <h4>Or Upload a Custom Test File</h4>
                    <div class="file-upload">
                        <InputFile OnChange="HandleFileSelected" accept=".json" />
                        @if (!string.IsNullOrEmpty(uploadedFileName))
                        {
                            <p class="file-info">Uploaded: <strong>@uploadedFileName</strong></p>
                        }
                    </div>
                </div>
            </div>

            @if (testResults.Any())
            {
                <div class="results-section">
                    <h3>Test Results</h3>
                    <div class="results-summary">
                        <div class="stat passed">
                            <span class="stat-icon">✅</span>
                            <div>
                                <p class="stat-number">@testResults.Count(r => r.Passed)</p>
                                <p class="stat-label">Passed</p>
                            </div>
                        </div>
                        <div class="stat failed">
                            <span class="stat-icon">❌</span>
                            <div>
                                <p class="stat-number">@testResults.Count(r => !r.Passed)</p>
                                <p class="stat-label">Failed</p>
                            </div>
                        </div>
                        <div class="stat total">
                            <span class="stat-icon">📊</span>
                            <div>
                                <p class="stat-number">@testResults.Count</p>
                                <p class="stat-label">Total</p>
                            </div>
                        </div>
                    </div>

                    <div class="results-list">
                        @foreach (var result in testResults)
                        {
                            <div class="result-item @(result.Passed ? "passed" : "failed")">
                                <div class="result-header">
                                    <span class="result-icon">@(result.Passed ? "✅" : "❌")</span>
                                    <span class="result-action">@result.Action</span>
                                    <span class="result-status">@(result.Passed ? "PASSED" : "FAILED")</span>
                                </div>
                                <div class="result-details">
                                    <p><strong>Message:</strong> @result.Message</p>
                                    @if (!string.IsNullOrEmpty(result.Details))
                                    {
                                        <p><strong>Details:</strong> @result.Details</p>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="example-section">
                <h3>Example Test JSON</h3>
                <p>Create a <code>tests.json</code> file with the following structure:</p>
                <pre class="example-json">{
  "testSuite": "Stage 1 CMS Smoke Tests",
  "steps": [
    {
      "action": "createPage",
      "params": { "name": "DemoTestPage" },
      "expect": { "created": true }
    },
    {
      "action": "addContent",
      "params": { 
        "pageName": "DemoTestPage", 
        "content": "Welcome to the CMS!" 
      },
      "expect": { "contentExists": true }
    },
    {
      "action": "verifyContent",
      "params": { "pageName": "DemoTestPage" },
      "expect": { "contentExists": true }
    }
  ]
}</pre>
            </div>
        </div>
    </div>
}

