@page "/admin/zoota-test"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Options
@using OrkinosaiCMS.Web.Models
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@layout OrkinosaiCMS.Web.Components.Layout.Admin.AdminLayout
@inject IOptions<ZootaTestingOptions> ZootaTestingOptions
@inject NavigationManager Navigation
@inject ILogger<ZootaTest> Logger
@inject HttpClient Http

<PageTitle>Zoota Test Runner - OrkinosaiCMS</PageTitle>

@if (!ZootaTestingOptions.Value.Enabled)
{
    <div class="test-disabled">
        <div class="disabled-message">
            <h2>⚠️ Test Runner Disabled</h2>
            <p>The Zoota Test Runner is currently disabled in configuration.</p>
            <p>To enable it, set <code>ZootaTesting:Enabled</code> to <code>true</code> in <code>appsettings.json</code>.</p>
            <button class="btn-back" @onclick='() => Navigation.NavigateTo("/admin")'>
                ← Back to Dashboard
            </button>
        </div>
    </div>
}
else
{
    <div class="test-runner">
        <div class="test-header">
            <h1>🧪 Zoota Test Runner</h1>
            <p>JSON-driven automated test suite for CMS feature validation</p>
        </div>

        <div class="test-content">
            <div class="upload-section">
                <h3>Upload Test File</h3>
                <p>Upload a JSON file containing test steps (e.g., <code>tests.json</code>)</p>
                
                <div class="file-upload">
                    <InputFile OnChange="HandleFileSelected" accept=".json" />
                    @if (!string.IsNullOrEmpty(selectedFileName))
                    {
                        <p class="file-info">Selected: <strong>@selectedFileName</strong></p>
                    }
                </div>

                @if (!string.IsNullOrEmpty(testJson))
                {
                    <div class="json-preview">
                        <h4>Test JSON Preview:</h4>
                        <pre>@testJson</pre>
                    </div>
                }

                <button class="btn-run" @onclick="RunTests" disabled="@(string.IsNullOrEmpty(testJson) || isRunning)">
                    @if (isRunning)
                    {
                        <span>⏳ Running Tests...</span>
                    }
                    else
                    {
                        <span>▶️ Run Tests</span>
                    }
                </button>
            </div>

            @if (testResults.Any())
            {
                <div class="results-section">
                    <h3>Test Results</h3>
                    <div class="results-summary">
                        <div class="stat passed">
                            <span class="stat-icon">✅</span>
                            <div>
                                <p class="stat-number">@testResults.Count(r => r.Passed)</p>
                                <p class="stat-label">Passed</p>
                            </div>
                        </div>
                        <div class="stat failed">
                            <span class="stat-icon">❌</span>
                            <div>
                                <p class="stat-number">@testResults.Count(r => !r.Passed)</p>
                                <p class="stat-label">Failed</p>
                            </div>
                        </div>
                        <div class="stat total">
                            <span class="stat-icon">📊</span>
                            <div>
                                <p class="stat-number">@testResults.Count</p>
                                <p class="stat-label">Total</p>
                            </div>
                        </div>
                    </div>

                    <div class="results-list">
                        @foreach (var result in testResults)
                        {
                            <div class="result-item @(result.Passed ? "passed" : "failed")">
                                <div class="result-header">
                                    <span class="result-icon">@(result.Passed ? "✅" : "❌")</span>
                                    <span class="result-action">@result.Action</span>
                                    <span class="result-status">@(result.Passed ? "PASSED" : "FAILED")</span>
                                </div>
                                <div class="result-details">
                                    <p><strong>Message:</strong> @result.Message</p>
                                    @if (!string.IsNullOrEmpty(result.Details))
                                    {
                                        <p><strong>Details:</strong> @result.Details</p>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="example-section">
                <h3>Example Test JSON</h3>
                <p>Create a <code>tests.json</code> file with the following structure:</p>
                <pre class="example-json">{
  "testSuite": "Stage 1 CMS Smoke Tests",
  "steps": [
    {
      "action": "createPage",
      "params": { "name": "DemoTestPage" },
      "expect": { "created": true }
    },
    {
      "action": "addContent",
      "params": { 
        "pageName": "DemoTestPage", 
        "content": "Welcome to the CMS!" 
      },
      "expect": { "contentExists": true }
    },
    {
      "action": "verifyContent",
      "params": { "pageName": "DemoTestPage" },
      "expect": { "contentExists": true }
    }
  ]
}</pre>
            </div>
        </div>
    </div>
}

