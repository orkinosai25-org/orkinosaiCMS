@page "/admin/pages"
@rendermode InteractiveServer
@layout OrkinosaiCMS.Web.Components.Layout.Admin.AdminLayout
@using Microsoft.AspNetCore.Authorization
@using OrkinosaiCMS.Core.Entities.Sites
@using OrkinosaiCMS.Core.Interfaces.Services
@inject IPageService PageService
@inject IMasterPageService MasterPageService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Pages Management - OrkinosaiCMS Admin</PageTitle>

<div class="pages-page">
    <div class="page-header">
        <div>
            <h1>Pages Management</h1>
            <p>Create and manage your CMS pages and content structure</p>
        </div>
        <div class="header-actions">
            <button class="btn-secondary" @onclick="ShowMasterPagesModal">
                📋 Master Pages
            </button>
            <button class="btn-primary" @onclick="ShowCreatePage">
                <span>➕</span> Create Page
            </button>
        </div>
    </div>

    <div class="filter-bar">
        <button class="filter-btn @(selectedFilter == "all" ? "active" : "")" @onclick='() => FilterPages("all")'>
            All Pages (@pages?.Count() ?? 0)
        </button>
        <button class="filter-btn @(selectedFilter == "published" ? "active" : "")" @onclick='() => FilterPages("published")'>
            📗 Published (@pages?.Count(p => p.IsPublished) ?? 0)
        </button>
        <button class="filter-btn @(selectedFilter == "drafts" ? "active" : "")" @onclick='() => FilterPages("drafts")'>
            📝 Drafts (@pages?.Count(p => !p.IsPublished) ?? 0)
        </button>
    </div>

    @if (pages == null)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Loading pages...</p>
        </div>
    }
    else if (!filteredPages.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">📄</div>
            <h3>No pages yet</h3>
            <p>Create your first page to get started with your CMS</p>
            <button class="btn-primary" @onclick="ShowCreatePage">
                Create Page
            </button>
        </div>
    }
    else
    {
        <div class="pages-table">
            <table>
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Path</th>
                        <th>Status</th>
                        <th>Master Page</th>
                        <th>Modified</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pg in filteredPages.OrderBy(p => p.Order))
                    {
                        <tr class="@(!pg.IsPublished ? "draft" : "")">
                            <td>
                                <div class="page-title">
                                    @if (!string.IsNullOrEmpty(pg.IconCssClass))
                                    {
                                        <span class="page-icon">@pg.IconCssClass</span>
                                    }
                                    <strong>@pg.Title</strong>
                                    @if (pg.ParentId.HasValue)
                                    {
                                        <span class="badge child">Child Page</span>
                                    }
                                </div>
                            </td>
                            <td><code>@pg.Path</code></td>
                            <td>
                                @if (pg.IsPublished)
                                {
                                    <span class="status-badge published">✓ Published</span>
                                }
                                else
                                {
                                    <span class="status-badge draft">📝 Draft</span>
                                }
                            </td>
                            <td>@(GetMasterPageName(pg.MasterPageId) ?? "Default")</td>
                            <td>@(pg.ModifiedOn?.ToString("MMM dd, yyyy") ?? pg.CreatedOn.ToString("MMM dd, yyyy"))</td>
                            <td>
                                <div class="action-buttons">
                                    <button class="btn-icon" @onclick="() => EditPage(pg)" title="Edit">
                                        ✏️
                                    </button>
                                    @if (pg.IsPublished)
                                    {
                                        <button class="btn-icon" @onclick="() => UnpublishPage(pg)" title="Unpublish">
                                            ⏸️
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn-icon" @onclick="() => PublishPage(pg)" title="Publish">
                                            🚀
                                        </button>
                                    }
                                    <button class="btn-icon" @onclick="() => PreviewPage(pg)" title="Preview">
                                        👁️
                                    </button>
                                    <button class="btn-icon danger" @onclick="() => DeletePage(pg)" title="Delete">
                                        🗑️
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (showPageEditor)
    {
        <div class="modal-overlay" @onclick="ClosePageEditor">
            <div class="modal-content large" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h2>@(editingPage?.Id > 0 ? "Edit Page" : "Create Page")</h2>
                    <button class="btn-close" @onclick="ClosePageEditor">✕</button>
                </div>
                <div class="modal-body">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Page Title *</label>
                            <input type="text" class="form-control" @bind="editingPage!.Title" placeholder="e.g., About Us" />
                        </div>
                        <div class="form-group">
                            <label>URL Path *</label>
                            <input type="text" class="form-control" @bind="editingPage!.Path" placeholder="e.g., /about" />
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label>Parent Page</label>
                            <select class="form-control" @bind="editingPage!.ParentId">
                                <option value="">None (Top Level)</option>
                                @if (pages != null)
                                {
                                    @foreach (var p in pages.Where(p => p.Id != editingPage.Id))
                                    {
                                        <option value="@p.Id">@p.Title</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Master Page</label>
                            <select class="form-control" @bind="editingPage!.MasterPageId">
                                <option value="">Default</option>
                                @if (masterPages != null)
                                {
                                    @foreach (var mp in masterPages)
                                    {
                                        <option value="@mp.Id">@mp.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Meta Description</label>
                        <textarea class="form-control" @bind="editingPage!.MetaDescription" rows="2" placeholder="SEO description"></textarea>
                    </div>

                    <div class="form-group">
                        <label>Meta Keywords</label>
                        <input type="text" class="form-control" @bind="editingPage!.MetaKeywords" placeholder="keyword1, keyword2, keyword3" />
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Icon CSS Class</label>
                            <input type="text" class="form-control" @bind="editingPage!.IconCssClass" placeholder="e.g., 🏠" />
                        </div>
                        <div class="form-group">
                            <label>Display Order</label>
                            <input type="number" class="form-control" @bind="editingPage!.Order" min="0" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Required Permission</label>
                        <input type="text" class="form-control" @bind="editingPage!.RequiredPermission" placeholder="e.g., Administrator" />
                    </div>

                    <div class="form-group">
                        <label>Page Content</label>
                        <textarea class="form-control content-editor" @bind="editingPage!.Content" rows="8" placeholder="Enter page content (HTML supported)"></textarea>
                    </div>

                    <div class="form-group checkbox-group">
                        <label>
                            <input type="checkbox" @bind="editingPage!.ShowInNavigation" />
                            <span>Show in navigation</span>
                        </label>
                    </div>
                    
                    <div class="form-group checkbox-group">
                        <label>
                            <input type="checkbox" @bind="editingPage!.IsPublished" />
                            <span>Publish immediately</span>
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn-secondary" @onclick="ClosePageEditor">Cancel</button>
                    <button class="btn-primary" @onclick="SavePage">
                        @(editingPage?.Id > 0 ? "Update Page" : "Create Page")
                    </button>
                </div>
            </div>
        </div>
    }

    @if (showMasterPages)
    {
        <div class="modal-overlay" @onclick="CloseMasterPagesModal">
            <div class="modal-content large" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h2>Master Pages</h2>
                    <button class="btn-close" @onclick="CloseMasterPagesModal">✕</button>
                </div>
                <div class="modal-body">
                    @if (masterPages == null)
                    {
                        <div class="loading">Loading master pages...</div>
                    }
                    else if (!masterPages.Any())
                    {
                        <div class="empty-state">
                            <p>No master pages found</p>
                        </div>
                    }
                    else
                    {
                        <div class="master-pages-grid">
                            @foreach (var mp in masterPages)
                            {
                                <div class="master-page-card @(mp.IsDefault ? "default" : "")">
                                    <div class="mp-header">
                                        <h3>@mp.Name</h3>
                                        @if (mp.IsDefault)
                                        {
                                            <span class="badge default">Default</span>
                                        }
                                    </div>
                                    <p class="mp-description">@mp.Description</p>
                                    <div class="mp-meta">
                                        <span><strong>Component:</strong> @mp.ComponentPath</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn-secondary" @onclick="CloseMasterPagesModal">Close</button>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .pages-page {
        padding: 30px;
        max-width: 1600px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 24px;
        padding-bottom: 24px;
        border-bottom: 2px solid #e5e7eb;
    }

    .page-header h1 {
        color: #0078D4;
        font-size: 32px;
        margin: 0 0 8px 0;
    }

    .page-header p {
        color: #666;
        font-size: 16px;
        margin: 0;
    }

    .header-actions {
        display: flex;
        gap: 12px;
    }

    .filter-bar {
        display: flex;
        gap: 12px;
        margin-bottom: 24px;
    }

    .filter-btn {
        padding: 10px 20px;
        border: 2px solid #e5e7eb;
        background: white;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        color: #4b5563;
        cursor: pointer;
        transition: all 0.2s;
    }

    .filter-btn:hover {
        border-color: #0078D4;
        color: #0078D4;
    }

    .filter-btn.active {
        background: #0078D4;
        color: white;
        border-color: #0078D4;
    }

    .btn-primary {
        padding: 10px 20px;
        background: #0078D4;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: background 0.2s;
    }

    .btn-primary:hover {
        background: #005a9e;
    }

    .btn-secondary {
        padding: 10px 20px;
        background: #6b7280;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.2s;
    }

    .btn-secondary:hover {
        background: #4b5563;
    }

    .loading {
        text-align: center;
        padding: 60px 20px;
        color: #666;
    }

    .spinner {
        width: 40px;
        height: 40px;
        border: 4px solid #f3f4f6;
        border-top: 4px solid #0078D4;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto 16px;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    .empty-state {
        text-align: center;
        padding: 80px 20px;
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .empty-icon {
        font-size: 64px;
        margin-bottom: 16px;
    }

    .empty-state h3 {
        color: #333;
        margin-bottom: 8px;
    }

    .empty-state p {
        color: #666;
        margin-bottom: 24px;
    }

    .pages-table {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead {
        background: #f9fafb;
        border-bottom: 2px solid #e5e7eb;
    }

    th {
        padding: 16px;
        text-align: left;
        font-weight: 600;
        color: #374151;
        font-size: 14px;
    }

    td {
        padding: 16px;
        border-bottom: 1px solid #e5e7eb;
        font-size: 14px;
        color: #4b5563;
    }

    tr.draft {
        background: #fef3c7;
    }

    tr:last-child td {
        border-bottom: none;
    }

    .page-title {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .page-icon {
        font-size: 18px;
    }

    .badge {
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .badge.child {
        background: #e0e7ff;
        color: #4338ca;
    }

    .badge.default {
        background: #dcfce7;
        color: #166534;
    }

    .status-badge {
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 500;
        display: inline-block;
    }

    .status-badge.published {
        background: #dcfce7;
        color: #166534;
    }

    .status-badge.draft {
        background: #fef3c7;
        color: #92400e;
    }

    code {
        background: #f3f4f6;
        padding: 4px 8px;
        border-radius: 4px;
        font-family: 'Courier New', monospace;
        font-size: 13px;
    }

    .action-buttons {
        display: flex;
        gap: 8px;
    }

    .btn-icon {
        padding: 6px 10px;
        background: #f3f4f6;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 16px;
        transition: all 0.2s;
    }

    .btn-icon:hover {
        background: #e5e7eb;
        transform: scale(1.1);
    }

    .btn-icon.danger:hover {
        background: #fee2e2;
    }

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 20px;
    }

    .modal-content {
        background: white;
        border-radius: 12px;
        max-width: 600px;
        width: 100%;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    }

    .modal-content.large {
        max-width: 900px;
    }

    .modal-header {
        padding: 24px;
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .modal-header h2 {
        margin: 0;
        color: #111827;
        font-size: 24px;
    }

    .btn-close {
        background: none;
        border: none;
        font-size: 24px;
        cursor: pointer;
        color: #6b7280;
        padding: 0;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
    }

    .btn-close:hover {
        background: #f3f4f6;
        color: #111827;
    }

    .modal-body {
        padding: 24px;
    }

    .modal-footer {
        padding: 16px 24px;
        border-top: 1px solid #e5e7eb;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 16px;
    }

    .form-group {
        margin-bottom: 16px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 500;
        color: #374151;
        font-size: 14px;
    }

    .form-control {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        font-size: 14px;
        transition: border-color 0.2s;
    }

    .form-control:focus {
        outline: none;
        border-color: #0078D4;
        box-shadow: 0 0 0 3px rgba(0, 120, 212, 0.1);
    }

    .content-editor {
        font-family: 'Courier New', monospace;
        resize: vertical;
    }

    .checkbox-group {
        display: flex;
        align-items: center;
    }

    .checkbox-group label {
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        margin-bottom: 0;
    }

    .checkbox-group input[type="checkbox"] {
        width: 18px;
        height: 18px;
        cursor: pointer;
    }

    .master-pages-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 16px;
    }

    .master-page-card {
        padding: 20px;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        transition: all 0.2s;
    }

    .master-page-card.default {
        border-color: #0078D4;
        background: #f0f9ff;
    }

    .master-page-card:hover {
        border-color: #0078D4;
    }

    .mp-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .mp-header h3 {
        margin: 0;
        color: #111827;
        font-size: 18px;
    }

    .mp-description {
        color: #6b7280;
        margin-bottom: 12px;
        font-size: 14px;
    }

    .mp-meta {
        font-size: 12px;
        color: #9ca3af;
    }

    @@media (max-width: 768px) {
        .pages-table {
            overflow-x: auto;
        }

        .page-header {
            flex-direction: column;
            gap: 16px;
        }

        .header-actions {
            width: 100%;
        }

        .header-actions button {
            flex: 1;
        }

        .form-row {
            grid-template-columns: 1fr;
        }

        .filter-bar {
            flex-wrap: wrap;
        }
    }
</style>

@code {
    private List<Page>? pages;
    private List<Page> filteredPages = new();
    private List<MasterPage>? masterPages;
    private string selectedFilter = "all";
    private bool showPageEditor = false;
    private bool showMasterPages = false;
    private Page? editingPage;
    private const int DefaultSiteId = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadPages();
        await LoadMasterPages();
    }

    private async Task LoadPages()
    {
        try
        {
            var allPages = await PageService.GetBySiteAsync(DefaultSiteId);
            pages = allPages.ToList();
            FilterPages(selectedFilter);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading pages: {ex.Message}");
        }
    }

    private async Task LoadMasterPages()
    {
        try
        {
            var allMasterPages = await MasterPageService.GetBySiteAsync(DefaultSiteId);
            masterPages = allMasterPages.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading master pages: {ex.Message}");
        }
    }

    private void FilterPages(string filter)
    {
        selectedFilter = filter;
        if (pages == null) return;

        filteredPages = filter switch
        {
            "published" => pages.Where(p => p.IsPublished).ToList(),
            "drafts" => pages.Where(p => !p.IsPublished).ToList(),
            _ => pages.ToList()
        };
    }

    private string? GetMasterPageName(int? masterPageId)
    {
        if (!masterPageId.HasValue || masterPages == null) return null;
        return masterPages.FirstOrDefault(mp => mp.Id == masterPageId.Value)?.Name;
    }

    private void ShowCreatePage()
    {
        editingPage = new Page
        {
            SiteId = DefaultSiteId,
            IsPublished = false,
            ShowInNavigation = true,
            Order = pages?.Count() ?? 0
        };
        showPageEditor = true;
    }

    private void EditPage(Page page)
    {
        editingPage = new Page
        {
            Id = page.Id,
            SiteId = page.SiteId,
            ParentId = page.ParentId,
            Title = page.Title,
            Path = page.Path,
            Content = page.Content,
            MasterPageId = page.MasterPageId,
            Order = page.Order,
            IsPublished = page.IsPublished,
            ShowInNavigation = page.ShowInNavigation,
            MetaDescription = page.MetaDescription,
            MetaKeywords = page.MetaKeywords,
            IconCssClass = page.IconCssClass,
            RequiredPermission = page.RequiredPermission
        };
        showPageEditor = true;
    }

    private async Task SavePage()
    {
        if (editingPage == null) return;

        try
        {
            if (string.IsNullOrWhiteSpace(editingPage.Title))
            {
                await JSRuntime.InvokeVoidAsync("alert", "Please enter a page title");
                return;
            }

            if (string.IsNullOrWhiteSpace(editingPage.Path))
            {
                await JSRuntime.InvokeVoidAsync("alert", "Please enter a page path");
                return;
            }

            if (editingPage.Id > 0)
            {
                // Update existing page
                await PageService.UpdateAsync(editingPage);
            }
            else
            {
                // Create new page
                await PageService.CreateAsync(editingPage);
            }

            await LoadPages();
            ClosePageEditor();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error saving page: {ex.Message}");
        }
    }

    private void ClosePageEditor()
    {
        showPageEditor = false;
        editingPage = null;
    }

    private async Task PublishPage(Page page)
    {
        try
        {
            await PageService.PublishAsync(page.Id);
            await LoadPages();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error publishing page: {ex.Message}");
        }
    }

    private async Task UnpublishPage(Page page)
    {
        try
        {
            await PageService.UnpublishAsync(page.Id);
            await LoadPages();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error unpublishing page: {ex.Message}");
        }
    }

    private async Task DeletePage(Page page)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to delete '{page.Title}'?");
        if (!confirmed) return;

        try
        {
            await PageService.DeleteAsync(page.Id);
            await LoadPages();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error deleting page: {ex.Message}");
        }
    }

    private void PreviewPage(Page page)
    {
        NavigationManager.NavigateTo(page.Path, true);
    }

    private void ShowMasterPagesModal()
    {
        showMasterPages = true;
    }

    private void CloseMasterPagesModal()
    {
        showMasterPages = false;
    }
}
